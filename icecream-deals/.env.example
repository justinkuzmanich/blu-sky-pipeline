# ---- Scraper ----
# Firecrawl is strongly recommended: Safeway returns HTTP 403 to plain requests.
# Get a key at https://firecrawl.dev. Without it, the scraper falls back to a
# direct fetch that Safeway will very likely block.
FIRECRAWL_API_KEY=

# ---- Email alerts (pluggable) ----
# Pick ONE provider. If none is set, the scraper runs in "console" mode and
# just prints the alert instead of sending it.
#
# Resend (https://resend.com) — simplest, generous free tier:
RESEND_API_KEY=
ALERT_FROM="Scoop Alert <alerts@yourdomain.com>"
ALERT_TO=justin.kuzmanich@gmail.com
